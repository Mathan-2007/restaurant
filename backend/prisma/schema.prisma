generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  MANAGER
  CASHIER
  WAITER
  KITCHEN_STAFF
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum TaskStatus {
  SCHEDULED
  AVAILABLE
  IN_PROGRESS
  AWAITING_EVIDENCE
  AWAITING_APPROVAL
  COMPLETED
  OVERDUE
  REJECTED
  CANCELLED
}

enum TaskAssignmentMode {
  INDIVIDUAL
  COLLABORATIVE
  INDIVIDUAL_COPIES
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  PREPARING
  PARTIALLY_READY
  READY
  SERVED
  AWAITING_PAYMENT
  PAID
  COMPLETED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  AWAITING_ORDER
  ORDER_IN_PROGRESS
  AWAITING_PAYMENT
  PAID
  CLEANING
  RESERVED
  UNAVAILABLE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PrintStatus {
  PENDING
  PRINTED
  FAILED
  CANCELLED
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  CUSTOM
}

model Role {
  id    String   @id @default(cuid())
  name  RoleName @unique
  users User[]
}

model User {
  id                       String                   @id @default(cuid())
  email                    String                   @unique
  passwordHash             String
  fullName                 String
  phone                    String?
  status                   EmployeeStatus           @default(ACTIVE)
  archivedAt               DateTime?
  forcePasswordChange      Boolean                  @default(false)
  roleId                   String
  role                     Role                     @relation(fields: [roleId], references: [id])
  employeeAssignments      EmployeeShopAssignment[]
  managerAssignments       ManagerShopAssignment[]
  profile                  EmployeeProfile?
  shifts                   Shift[]
  sessions                 Session[]
  taskAssignments          TaskAssignmentMember[]
  ordersCreated            Order[]                  @relation("OrderCreator")
  revisions                OrderRevision[]
  auditLogs                AuditLog[]
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  failedLoginAttempts      Int                      @default(0)
  lockoutEnd               DateTime?
  passwordChangedAt        DateTime?
  passwordResetToken       String?                  @unique
  passwordResetExpires     DateTime?
  emailVerified            Boolean                  @default(false)
  emailVerificationToken   String?                  @unique
  emailVerificationExpires DateTime?
  phoneVerified            Boolean                  @default(false)
  phoneVerificationToken   String?                  @unique
  phoneVerificationExpires DateTime?
  shopId                   String?
  shop                     Shop?                    @relation(fields: [shopId], references: [id])
  sequenceNumber           Int                      @default(0)

  @@index([roleId, status])
}

model Shop {
  id                  String                   @id @default(cuid())
  code                String                   @unique
  name                String
  timezone            String                   @default("Asia/Kolkata")
  isOpen              Boolean                  @default(false)
  active              Boolean                  @default(true)
  archivedAt          DateTime?
  address             String?
  phone               String?
  settings            ShopSettings?
  managerAssignments  ManagerShopAssignment[]
  employeeAssignments EmployeeShopAssignment[]
  tables              RestaurantTable[]
  categories          MenuCategory[]
  orders              Order[]
  tasks               TaskAssignment[]
  inventory           InventoryItem[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  TableArea           TableArea[]
  TableArchive        TableArchive[]
  User                User[]
}

model ShopSettings {
  id                          String  @id @default(cuid())
  shopId                      String  @unique
  shop                        Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  takeawayStartsBeforePayment Boolean @default(false)
  dineInAvailable             Boolean @default(true)
  takeawayAvailable           Boolean @default(true)
  openingTime                 String?
  closingTime                 String?
  orderStartTime              String?
  orderEndTime                String?
  currency                    String  @default("INR")
  timezone                    String  @default("Asia/Kolkata")
  taxPercent                  Decimal @default(0) @db.Decimal(5, 2)
  refundApprovalRequired      Boolean @default(true)
}

model ManagerShopAssignment {
  userId    String
  shopId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, shopId])
}

model EmployeeShopAssignment {
  userId String
  shopId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([userId, shopId])
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  revokedAt     DateTime?
  csrfTokenHash String
  userAgent     String?
  ipAddress     String?
  createdAt     DateTime  @default(now())

  @@index([userId, expiresAt, revokedAt])
}

model TaskTemplate {
  id                 String                  @id @default(cuid())
  shopId             String
  title              String
  description        String?
  recurrence         RecurrenceType          @default(NONE)
  photoRequired      Boolean                 @default(false)
  requiredPhotoCount Int                     @default(0)
  approvalRequired   Boolean                 @default(false)
  active             Boolean                 @default(true)
  checklists         TaskTemplateChecklist[]
  schedules          TaskSchedule[]
  createdAt          DateTime                @default(now())
}

model TaskTemplateChecklist {
  id         String       @id @default(cuid())
  templateId String
  template   TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label      String
  isRequired Boolean      @default(true)
  sortOrder  Int          @default(0)
}

model TaskSchedule {
  id               String       @id @default(cuid())
  templateId       String
  template         TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  shopId           String
  startsAt         DateTime
  endsAt           DateTime
  recurrenceRule   String?
  active           Boolean      @default(true)
  lastGeneratedAt  DateTime?
  nextOccurrenceAt DateTime?

  @@index([shopId, startsAt, active])
}

model TaskAssignment {
  id                 String                 @id @default(cuid())
  shopId             String
  shop               Shop                   @relation(fields: [shopId], references: [id])
  title              String
  description        String?
  status             TaskStatus             @default(SCHEDULED)
  completionMode     TaskAssignmentMode     @default(INDIVIDUAL)
  scheduledStart     DateTime
  scheduledEnd       DateTime
  actualStart        DateTime?
  completedAt        DateTime?
  priority           Int                    @default(2)
  photoRequired      Boolean                @default(false)
  requiredPhotoCount Int                    @default(0)
  approvalRequired   Boolean                @default(false)
  occurrenceKey      String?                @unique
  members            TaskAssignmentMember[]
  checklists         TaskChecklist[]
  photoEvidence      TaskPhotoEvidence[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([shopId, status, scheduledStart])
}

model TaskAssignmentMember {
  id           String         @id @default(cuid())
  assignmentId String
  assignment   TaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  status       TaskStatus     @default(SCHEDULED)

  @@unique([assignmentId, userId])
}

model TaskChecklist {
  id           String                  @id @default(cuid())
  assignmentId String
  assignment   TaskAssignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  label        String
  isRequired   Boolean                 @default(true)
  sortOrder    Int                     @default(0)
  responses    TaskChecklistResponse[]
}

model TaskChecklistResponse {
  id          String        @id @default(cuid())
  checklistId String
  checklist   TaskChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  userId      String
  completed   Boolean       @default(false)
  completedAt DateTime?

  @@unique([checklistId, userId])
}

model TaskPhotoEvidence {
  id           String         @id @default(cuid())
  assignmentId String
  assignment   TaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  fileName     String
  mimeType     String
  fileSize     Int
  storagePath  String
  createdAt    DateTime       @default(now())
}

model TaskCompletionRecord {
  id           String   @id @default(cuid())
  assignmentId String
  shopId       String
  userId       String
  completedAt  DateTime @default(now())

  @@index([shopId, completedAt])
}

model MenuCategory {
  id        String     @id @default(cuid())
  shopId    String
  shop      Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  items     MenuItem[]

  @@unique([shopId, name])
}

model MenuItem {
  id             String             @id @default(cuid())
  categoryId     String
  category       MenuCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  imageUrl       String?
  sortOrder      Int                @default(0)
  active         Boolean            @default(true)
  soldOut        Boolean            @default(false)
  price          Decimal            @db.Decimal(12, 2)
  variants       MenuItemVariant[]
  addons         MenuItemAddon[]
  availabilities MenuAvailability[]
  orderItems     OrderItem[]
}

model MenuItemVariant {
  id            String   @id @default(cuid())
  itemId        String
  item          MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name          String
  priceModifier Decimal  @db.Decimal(12, 2)
}

model MenuItemAddon {
  id     String   @id @default(cuid())
  itemId String
  item   MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name   String
  price  Decimal  @db.Decimal(12, 2)
}

model MenuAvailability {
  id       String    @id @default(cuid())
  itemId   String
  item     MenuItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  startsAt DateTime?
  endsAt   DateTime?
  active   Boolean   @default(true)
}

model RestaurantTable {
  id           String         @id @default(cuid())
  shopId       String
  shop         Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  number       String
  name         String?
  diningArea   String         @default("Main Hall")
  capacity     Int
  status       TableStatus    @default(AVAILABLE)
  active       Boolean        @default(true)
  archivedAt   DateTime?
  sessions     TableSession[]
  TableArchive TableArchive[]

  @@unique([shopId, number])
}

model TableSession {
  id       String          @id @default(cuid())
  tableId  String
  table    RestaurantTable @relation(fields: [tableId], references: [id])
  active   Boolean         @default(true)
  openedAt DateTime        @default(now())
  closedAt DateTime?
  orders   Order[]
}

model Order {
  id             String               @id @default(cuid())
  shopId         String
  shop           Shop                 @relation(fields: [shopId], references: [id])
  orderNumber    String               @unique
  type           OrderType
  status         OrderStatus          @default(DRAFT)
  tableSessionId String?
  tableSession   TableSession?        @relation(fields: [tableSessionId], references: [id])
  createdById    String
  createdBy      User                 @relation("OrderCreator", fields: [createdById], references: [id])
  version        Int                  @default(1)
  subtotal       Decimal              @db.Decimal(12, 2)
  tax            Decimal              @db.Decimal(12, 2)
  total          Decimal              @db.Decimal(12, 2)
  items          OrderItem[]
  revisions      OrderRevision[]
  invoices       Invoice[]
  payments       Payment[]
  kitchenTickets KitchenTicket[]
  statusHistory  OrderStatusHistory[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([shopId, status, createdAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId   String
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id])
  nameSnapshot String
  quantity     Int
  unitPrice    Decimal  @db.Decimal(12, 2)
  lineTotal    Decimal  @db.Decimal(12, 2)
  instructions String?
}

model OrderRevision {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  revisionNumber Int
  editedById     String
  editedBy       User     @relation(fields: [editedById], references: [id])
  reason         String?
  beforeJson     Json
  afterJson      Json
  createdAt      DateTime @default(now())

  @@unique([orderId, revisionNumber])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  changedById String?
  createdAt   DateTime    @default(now())
}

model KitchenTicket {
  id             String              @id @default(cuid())
  shopId         String
  orderId        String
  order          Order               @relation(fields: [orderId], references: [id])
  revisionNumber Int                 @default(1)
  status         String              @default("NEW")
  items          KitchenTicketItem[]
  printJobs      PrintJob[]
  createdAt      DateTime            @default(now())

  @@index([shopId, status, createdAt])
}

model KitchenTicketItem {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     KitchenTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  name       String
  quantity   Int
  changeType String        @default("UNCHANGED")
  status     String        @default("PENDING")
}

model Printer {
  id                 String     @id @default(cuid())
  shopId             String
  name               String
  paperWidth         Int        @default(80)
  type               String
  ipAddress          String?
  bridgeUrl          String?
  bridgeKeyEncrypted String?
  active             Boolean    @default(true)
  printJobs          PrintJob[]
}

model PrintJob {
  id            String        @id @default(cuid())
  shopId        String
  printerId     String
  printer       Printer       @relation(fields: [printerId], references: [id])
  ticketId      String
  ticket        KitchenTicket @relation(fields: [ticketId], references: [id])
  status        PrintStatus   @default(PENDING)
  payload       String        @db.Text
  attempts      Int           @default(0)
  lastError     String?
  lastAttemptAt DateTime?
  claimedAt     DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([shopId, status, createdAt])
}

model Invoice {
  id            String   @id @default(cuid())
  shopId        String
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  invoiceNumber String   @unique
  subtotal      Decimal  @db.Decimal(12, 2)
  tax           Decimal  @db.Decimal(12, 2)
  discount      Decimal  @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  @@index([shopId, createdAt])
}

model PaymentMethod {
  id     String  @id @default(cuid())
  shopId String
  code   String
  name   String
  active Boolean @default(true)

  @@unique([shopId, code])
}

model Payment {
  id             String        @id @default(cuid())
  shopId         String
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDING)
  methodCode     String
  reference      String?
  idempotencyKey String        @unique
  confirmedById  String?
  createdAt      DateTime      @default(now())

  @@index([shopId, status, createdAt])
}

model Refund {
  id           String   @id @default(cuid())
  shopId       String
  paymentId    String
  amount       Decimal  @db.Decimal(12, 2)
  reason       String
  approvedById String?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
}

model InventoryCategory {
  id     String @id @default(cuid())
  shopId String
  name   String
}

model InventoryItem {
  id           String                 @id @default(cuid())
  shopId       String
  shop         Shop                   @relation(fields: [shopId], references: [id])
  categoryId   String
  name         String
  unit         String
  quantity     Decimal                @db.Decimal(12, 3)
  minimum      Decimal                @db.Decimal(12, 3)
  transactions InventoryTransaction[]

  @@index([shopId, quantity])
}

model InventoryTransaction {
  id           String        @id @default(cuid())
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id])
  userId       String
  type         String
  quantity     Decimal       @db.Decimal(12, 3)
  balanceAfter Decimal       @db.Decimal(12, 3)
  note         String?
  createdAt    DateTime      @default(now())
}

model FoodPreparationRecord {
  id          String    @id @default(cuid())
  shopId      String
  menuItemId  String
  planned     Decimal   @db.Decimal(12, 3)
  actual      Decimal   @db.Decimal(12, 3)
  wasted      Decimal   @db.Decimal(12, 3)
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
}

model RemainingFoodRecord {
  id           String   @id @default(cuid())
  shopId       String
  menuItemId   String
  expected     Decimal  @db.Decimal(12, 3)
  actual       Decimal  @db.Decimal(12, 3)
  discrepancy  Decimal  @db.Decimal(12, 3)
  recordedById String
  createdAt    DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id])
  userId    String?
  type      String
  title     String
  body      String
  deepLink  String?
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([shopId, userId, read, createdAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  shopId        String?
  shop          Shop?    @relation(fields: [shopId], references: [id])
  actorId       String?
  actor         User?    @relation(fields: [actorId], references: [id])
  action        String
  module        String   @default("SYSTEM")
  resourceType  String
  resourceId    String
  requestId     String?
  ipAddress     String?
  userAgent     String?
  reason        String?
  result        String   @default("SUCCESS")
  beforeJson    Json?
  afterJson     Json?
  changedFields Json?
  createdAt     DateTime @default(now())

  @@index([shopId, action, createdAt])
  @@index([actorId, createdAt])
  @@index([module, createdAt])
}

model IdempotencyKey {
  id          String   @id @default(cuid())
  key         String   @unique
  scope       String
  actorId     String?
  shopId      String?
  fingerprint String?
  resultJson  Json?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([scope, actorId, shopId])
}

model OutboxEvent {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  processedAt DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([processedAt, createdAt])
}

model EmployeeProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode String?  @unique
  department   String?
  shiftNotes   String?
  joiningDate  DateTime @default(now())
  baseSalary   Decimal? @db.Decimal(12, 2)
  hourlyRate   Decimal? @db.Decimal(12, 2)
  dailyRate    Decimal? @db.Decimal(12, 2)
  overtimeRate Decimal? @db.Decimal(12, 2)
  adminNotes   String?
}

model Shift {
  id        String   @id @default(cuid())
  shopId    String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, startsAt])
  @@index([userId, startsAt])
}

model TableArea {
  id        String   @id @default(cuid())
  shopId    String
  name      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model TableArchive {
  id         String   @id @default(cuid())
  shopId     String
  tableId    String
  archivedAt DateTime @default(now())

  shop  Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  table RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
}

model TableReservation {
  id           String   @id @default(cuid())
  shopId       String
  tableId      String
  customerName String
  phone        String?
  partySize    Int
  reservedAt   DateTime
  status       String   @default("RESERVED")
  notes        String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([shopId, reservedAt, status])
}

model WaitingQueueEntry {
  id            String    @id @default(cuid())
  shopId        String
  customerName  String?
  phone         String?
  partySize     Int
  status        String    @default("WAITING")
  seatedTableId String?
  createdById   String
  calledAt      DateTime?
  seatedAt      DateTime?
  createdAt     DateTime  @default(now())

  @@index([shopId, status, createdAt])
}

model CashierSession {
  id                     String    @id @default(cuid())
  shopId                 String
  cashierId              String
  openingBalance         Decimal   @db.Decimal(12, 2)
  expectedClosingBalance Decimal?  @db.Decimal(12, 2)
  actualClosingBalance   Decimal?  @db.Decimal(12, 2)
  difference             Decimal?  @db.Decimal(12, 2)
  closingNotes           String?
  status                 String    @default("OPEN")
  openedAt               DateTime  @default(now())
  closedAt               DateTime?

  @@unique([shopId, cashierId, openedAt])
  @@index([shopId, status, openedAt])
}

model SplitPayment {
  id         String   @id @default(cuid())
  paymentId  String
  methodCode String
  amount     Decimal  @db.Decimal(12, 2)
  reference  String?
  createdAt  DateTime @default(now())

  @@index([paymentId])
}

model TaskDependency {
  id              String   @id @default(cuid())
  shopId          String
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime @default(now())

  @@unique([taskId, dependsOnTaskId])
}

model Permission {
  id        String   @id @default(cuid())
  roleName  RoleName
  module    String
  action    String
  allowed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([roleName, module, action])
  @@index([roleName, module])
}

model Supplier {
  id          String     @id @default(cuid())
  name        String
  code        String     @unique
  contactName String?
  email       String?
  phone       String?
  address     String?
  active      Boolean    @default(true)
  archivedAt  DateTime?
  purchases   Purchase[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Purchase {
  id              String         @id @default(cuid())
  purchaseNumber  String         @unique
  shopId          String
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  purchaseDate    DateTime
  subtotal        Decimal        @db.Decimal(12, 2)
  discount        Decimal        @db.Decimal(12, 2)
  tax             Decimal        @db.Decimal(12, 2)
  transportCost   Decimal        @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  status          String         @default("PENDING")
  paymentStatus   String         @default("UNPAID")
  paymentMethod   String?
  supplierInvoice String?
  purchasedById   String
  approvedById    String?
  notes           String?
  items           PurchaseItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([shopId, purchaseDate, status])
}

model PurchaseItem {
  id              String   @id @default(cuid())
  purchaseId      String
  purchase        Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  name            String
  quantity        Decimal  @db.Decimal(12, 3)
  unit            String
  unitPrice       Decimal  @db.Decimal(12, 2)
  lineTotal       Decimal  @db.Decimal(12, 2)
}

model Expense {
  id            String   @id @default(cuid())
  expenseNumber String   @unique
  shopId        String?
  category      String
  amount        Decimal  @db.Decimal(12, 2)
  expenseDate   DateTime
  status        String   @default("PENDING")
  paymentStatus String   @default("UNPAID")
  paymentMethod String?
  recurring     Boolean  @default(false)
  vendorName    String?
  notes         String?
  createdById   String
  approvedById  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([shopId, expenseDate, category])
}

model Payroll {
  id           String    @id @default(cuid())
  shopId       String
  userId       String
  periodStart  DateTime
  periodEnd    DateTime
  baseSalary   Decimal   @db.Decimal(12, 2)
  overtime     Decimal   @default(0) @db.Decimal(12, 2)
  allowance    Decimal   @default(0) @db.Decimal(12, 2)
  bonus        Decimal   @default(0) @db.Decimal(12, 2)
  deduction    Decimal   @default(0) @db.Decimal(12, 2)
  netPay       Decimal   @db.Decimal(12, 2)
  status       String    @default("DRAFT")
  approvedById String?
  paidAt       DateTime?
  createdAt    DateTime  @default(now())

  @@unique([shopId, userId, periodStart, periodEnd])
  @@index([shopId, periodStart, status])
}

model Recipe {
  id              String             @id @default(cuid())
  menuItemId      String             @unique
  version         Int                @default(1)
  preparationCost Decimal            @default(0) @db.Decimal(12, 2)
  packagingCost   Decimal            @default(0) @db.Decimal(12, 2)
  active          Boolean            @default(true)
  ingredients     RecipeIngredient[]
  createdAt       DateTime           @default(now())
}

model RecipeIngredient {
  id              String  @id @default(cuid())
  recipeId        String
  recipe          Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItemId String
  quantity        Decimal @db.Decimal(12, 3)
  unit            String
}

model FinancialLedgerEntry {
  id            String   @id @default(cuid())
  shopId        String?
  entryDate     DateTime
  type          String
  category      String
  debit         Decimal  @default(0) @db.Decimal(12, 2)
  credit        Decimal  @default(0) @db.Decimal(12, 2)
  referenceType String
  referenceId   String
  description   String?
  createdById   String
  createdAt     DateTime @default(now())

  @@index([shopId, entryDate, type, category])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model BackupRecord {
  id          String   @id @default(cuid())
  filename    String
  sizeBytes   BigInt
  checksum    String
  status      String   @default("COMPLETED")
  createdById String
  createdAt   DateTime @default(now())
}

model NumberSequence {
  id        String   @id @default(cuid())
  scope     String
  prefix    String
  year      Int?
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([scope, prefix, year])
}
